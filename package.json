{
  "name": "touchline-manager",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179",
    "build": "vite build",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "data:refresh": "python3 scripts/refresh-data.py",
    "data:profiles": "python3 scripts/enrich-player-profiles.py --all",
    "data:portraits": "python3 scripts/refresh-portraits.py",
    "data:release": "node scripts/release-rosters.mjs",
    "i18n:audit": "node scripts/audit-i18n.mjs --strict"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "i18next": "^26.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "vite": "^7.3.0"
  }
}
